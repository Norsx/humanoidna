<mujoco model="simple_humanoid_balance">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="0.02" armature="0.01"/>
    <geom friction="1.0 0.005 0.0001"/>
  </default>

  <worldbody>
    <light pos="0 -3 4" dir="0 1 -1"/>
    <geom name="ground" type="plane" size="3 3 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- Fixed foot / support point. The body above it is a simplified humanoid trunk. -->
    <body name="foot" pos="0 0 0.05">
      <geom name="foot_geom" type="box" size="0.18 0.08 0.03" rgba="0.2 0.2 0.2 1"/>

      <body name="torso" pos="0 0 0.03">
        <!-- qpos[0] is the ankle angle. q=0 means upright. -->
        <joint name="ankle" type="hinge" axis="0 1 0" limited="true" range="-1.2 1.2"/>
        <geom name="torso_geom" type="capsule" fromto="0 0 0.0 0 0 0.9" size="0.055" mass="6.0" rgba="0.1 0.4 0.9 1"/>
        <site name="com_marker" pos="0 0 0.45" size="0.025" rgba="1 0 0 1"/>
        <site name="head_marker" pos="0 0 0.92" size="0.035" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- ctrl[0] is ankle torque in Nm. -->
    <motor name="ankle_motor" joint="ankle" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
  </actuator>
</mujoco>
